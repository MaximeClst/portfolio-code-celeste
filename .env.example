# GoHighLevel API v2 — Private Integration Token
# Créer le token dans GHL : Settings > Integrations > Private Integrations
# Scopes requis : contacts.write, opportunities.write (si pipeline)
GHL_API_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxx

# Optionnel — crée une opportunité dans un pipeline à chaque lead.
# Renseigner les deux pour activer.
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=

# Meta Conversions API (server-side) — token d'accès du dataset/Pixel.
# Le Pixel ID est public (dans le code) ; ce token reste server-only.
META_CAPI_TOKEN=

# Slack Incoming Webhook du canal #prospects-code (notif nouveau prospect).
# À créer dans Slack : api.slack.com/apps > Incoming Webhooks > canal #prospects-code
SLACK_WEBHOOK_URL=
